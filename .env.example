# ============================================================
# Supabase
# ============================================================

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable / anon key.
# This is intended to be used by the client app, but still use
# a placeholder in .env.example so the example stays reusable.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key


# ============================================================
# Backend API
# ============================================================

# Local development example:
# EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Tunnel / deployed backend example:
EXPO_PUBLIC_BACKEND_URL=https://YOUR_BACKEND_HOST