# Mealventory Frontend (Expo / React Native) Environment Configuration

# -----------------------------------------------------------------------------
# 1. API Services URLs
# -----------------------------------------------------------------------------
# For physical iPhone testing (via Expo Go on the same Wi-Fi):
# Replace 192.168.1.50 with your computer's actual local IPv4 address.
# Windows: run `ipconfig` to find IPv4.
# Mac: run `ipconfig getifaddr en0`.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
EXPO_PUBLIC_AI_SERVICE_URL=http://192.168.1.50:8001

# For Mac iOS Simulator ONLY:
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
# EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8001

# Backward compatibility fallbacks
BACKEND_URL=http://192.168.1.50:8000
AI_SERVICE_URL=http://192.168.1.50:8001

# -----------------------------------------------------------------------------
# 2. Supabase Client Configuration (Ticket FE-05)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_REF].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here