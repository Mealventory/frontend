# Public client settings only. Never put private keys or database credentials here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Copy this file to .env.local and fill in the Supabase values above.
# Shared backend: all teammates use the current URL of the SAME running tunnel.
# This Quick Tunnel address is temporary. Confirm it with the backend host;
# replace it here and in .env.local if the host's tunnel URL changes.
EXPO_PUBLIC_BACKEND_URL=https://reverse-singh-biggest-mid.trycloudflare.com
# Alternative: your own backend tunnel URL, or http://<your-LAN-IP>:8000
# when the phone and backend computer are on the same Wi-Fi.
