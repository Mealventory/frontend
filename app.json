{
  "expo": {
    "name": "Mealventory",
    "slug": "mealventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mealventory",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mealventory.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Mealventory requires camera access to scan grocery receipts and barcodes."
      }
    },
    "android": {
      "package": "com.mealventory.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mealventory to access your camera to scan food items and receipts."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
