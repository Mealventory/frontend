{
  "expo": {
    "name": "Mealventory",
    "slug": "mealventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mealventory",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mealventory.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Mealventory requires camera access to scan grocery receipts and barcodes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mealventory.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mealventory to access your camera to scan food items and receipts."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa13e851-d5f6-4179-a1e3-6571dad7d73f"
      }
    }
  }
}
