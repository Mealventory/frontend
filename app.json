{
  "expo": {
    "name": "Mealventory",
    "slug": "mealventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mealventory",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/branding/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mealventory.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Mealventory requires camera access to scan grocery receipts and barcodes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "package": "com.mealventory.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#F6F8F4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mealventory to access your camera to scan food items and receipts."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#087F5B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/mealventory-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F8F4",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa13e851-d5f6-4179-a1e3-6571dad7d73f"
      }
    }
  }
}
